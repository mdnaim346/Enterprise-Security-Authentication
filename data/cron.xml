<odoo>
    <data noupdate="1">
        <record id="cron_close_expired_sessions" model="ir.cron">
            <field name="name">Security: Close Expired Sessions</field>
            <field name="model_id" ref="model_auth_user_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_expired_sessions()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_cleanup_expired_otp_codes" model="ir.cron">
            <field name="name">Security: Cleanup Expired OTP Codes</field>
            <field name="model_id" ref="model_auth_otp_code"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_expired_codes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_cleanup_old_audit_logs" model="ir.cron">
            <field name="name">Security: Cleanup Old Audit Logs</field>
            <field name="model_id" ref="model_auth_audit_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

<odoo>
    <data noupdate="1">
        <record id="auth_security_config_default" model="auth.security.config">
            <field name="name">Default Security Policy</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active" eval="True"/>
            <field name="enable_login_attempt_tracking" eval="True"/>
            <field name="enable_account_lock" eval="True"/>
            <field name="max_failed_attempts">5</field>
            <field name="lock_duration_minutes">30</field>
            <field name="enable_session_tracking" eval="True"/>
            <field name="session_timeout_minutes">480</field>
            <field name="session_cleanup_days">30</field>
            <field name="enable_ip_restriction" eval="False"/>
            <field name="enable_email_otp" eval="False"/>
            <field name="enable_totp" eval="False"/>
            <field name="otp_expiration_minutes">10</field>
            <field name="otp_max_attempts">3</field>
            <field name="send_login_notification" eval="True"/>
            <field name="track_user_activity" eval="True"/>
            <field name="audit_password_reset" eval="True"/>
            <field name="audit_retention_days">365</field>
        </record>
    </data>
</odoo>

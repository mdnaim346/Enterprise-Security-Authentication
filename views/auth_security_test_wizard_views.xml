<odoo>
    <record id="view_auth_security_test_wizard_form" model="ir.ui.view">
        <field name="name">auth.security.test.wizard.form</field>
        <field name="model">auth.security.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Security Test Console" class="o_esa_test_console">
                <header>
                    <button name="action_run_selected_scenario" type="object" string="Run Scenario" class="btn-primary" icon="fa-play"/>
                    <button name="action_clear_test_data" type="object" string="Clear Test Data" class="btn-secondary" icon="fa-trash" confirm="Remove generated test records for this user and IP?"/>
                    <button name="action_unlock_test_user" type="object" string="Unlock User" class="btn-secondary" icon="fa-unlock" invisible="not is_user_locked"/>
                </header>
                <sheet>
                    <field name="is_user_locked" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_login_attempts" type="object" class="oe_stat_button" icon="fa-key">
                            <field name="test_login_attempt_count" widget="statinfo" string="Attempts"/>
                        </button>
                        <button name="action_open_sessions" type="object" class="oe_stat_button" icon="fa-desktop">
                            <field name="test_active_session_count" widget="statinfo" string="Active Sessions"/>
                        </button>
                        <button name="action_open_audit_logs" type="object" class="oe_stat_button" icon="fa-shield">
                            <field name="test_audit_log_count" widget="statinfo" string="Audit Logs"/>
                        </button>
                        <button name="action_open_otp_codes" type="object" class="oe_stat_button" icon="fa-envelope">
                            <field name="test_otp_code_count" widget="statinfo" string="OTP Codes"/>
                        </button>
                    </div>

                    <div class="o_esa_console_header">
                        <div>
                            <label for="scenario" class="o_esa_kicker"/>
                            <h1>Security Test Console</h1>
                            <div class="o_esa_policy_row">
                                <span>Active policy</span>
                                <field name="security_config_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                                <button name="action_open_security_policy" type="object" string="Open Policy" class="btn-link" icon="fa-arrow-right"/>
                            </div>
                        </div>
                        <div class="o_esa_lock_badge" invisible="not is_user_locked">
                            <span>Locked Until</span>
                            <field name="user_locked_until" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_esa_lock_badge o_esa_lock_badge_clear" invisible="is_user_locked">
                            <span>User Status</span>
                            <strong>Unlocked</strong>
                        </div>
                    </div>

                    <div class="o_esa_metric_grid">
                        <div class="o_esa_metric_tile o_esa_tile_total">
                            <span>Total Test Records</span>
                            <field name="test_total_count" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_esa_metric_tile o_esa_tile_warning">
                            <span>Failed Attempts</span>
                            <field name="test_failed_attempt_count" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_esa_metric_tile o_esa_tile_success">
                            <span>Successful Logins</span>
                            <field name="test_success_attempt_count" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_esa_metric_tile o_esa_tile_danger">
                            <span>Critical Events</span>
                            <field name="test_critical_log_count" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <group class="o_esa_scenario_panel">
                        <group string="Scenario Runner">
                            <field name="scenario" widget="radio" options="{'horizontal': true}"/>
                            <field name="failed_attempt_count"/>
                            <field name="mark_locked"/>
                            <field name="otp_code" password="True"/>
                        </group>
                        <group string="Request Profile">
                            <field name="user_id"/>
                            <field name="login"/>
                            <field name="ip_address"/>
                            <field name="device_name"/>
                            <field name="location"/>
                            <field name="user_agent"/>
                        </group>
                    </group>

                    <div class="o_esa_action_grid">
                        <button name="action_generate_all" type="object" string="Full Dataset" class="btn-primary" icon="fa-magic"/>
                        <button name="action_run_lockout_drill" type="object" string="Lockout Drill" class="btn-secondary" icon="fa-lock"/>
                        <button name="action_generate_failed_attempts" type="object" string="Failed Attempts" class="btn-secondary" icon="fa-times-circle"/>
                        <button name="action_generate_successful_login" type="object" string="Successful Login" class="btn-secondary" icon="fa-check-circle"/>
                        <button name="action_create_active_session" type="object" string="Active Session" class="btn-secondary" icon="fa-desktop"/>
                        <button name="action_create_audit_logs" type="object" string="Audit Events" class="btn-secondary" icon="fa-list"/>
                        <button name="action_create_otp_code" type="object" string="Email OTP" class="btn-secondary" icon="fa-envelope"/>
                        <button name="action_unlock_test_user" type="object" string="Unlock User" class="btn-secondary" icon="fa-unlock"/>
                    </div>

                    <group string="Latest Signal" class="o_esa_latest_signal">
                        <field name="last_event_type" readonly="1"/>
                        <field name="last_event_at" readonly="1"/>
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auth_security_test_wizard" model="ir.actions.act_window">
        <field name="name">Security Test Console</field>
        <field name="res_model">auth.security.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_auth_security_test_wizard_form"/>
        <field name="target">current</field>
    </record>
</odoo>

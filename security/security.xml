<odoo>
    <record id="module_category_enterprise_security_authentication" model="ir.module.category">
        <field name="name">Enterprise Security Authentication</field>
        <field name="description">Manage authentication, sessions, OTP, and security audit controls.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_security_user" model="res.groups">
        <field name="name">Security User</field>
        <field name="category_id" ref="enterprise_security_authentication.module_category_enterprise_security_authentication"/>
    </record>

    <record id="group_security_manager" model="res.groups">
        <field name="name">Security Manager</field>
        <field name="category_id" ref="enterprise_security_authentication.module_category_enterprise_security_authentication"/>
        <field name="implied_ids" eval="[(4, ref('enterprise_security_authentication.group_security_user'))]"/>
    </record>

    <record id="rule_login_attempt_user_own" model="ir.rule">
        <field name="name">Login attempts: own records</field>
        <field name="model_id" ref="model_auth_login_attempt"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('enterprise_security_authentication.group_security_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_login_attempt_manager_all" model="ir.rule">
        <field name="name">Login attempts: managers see all</field>
        <field name="model_id" ref="model_auth_login_attempt"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('enterprise_security_authentication.group_security_manager'))]"/>
    </record>

    <record id="rule_user_session_user_own" model="ir.rule">
        <field name="name">Sessions: own records</field>
        <field name="model_id" ref="model_auth_user_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('enterprise_security_authentication.group_security_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_user_session_manager_all" model="ir.rule">
        <field name="name">Sessions: managers see all</field>
        <field name="model_id" ref="model_auth_user_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('enterprise_security_authentication.group_security_manager'))]"/>
    </record>

    <record id="rule_audit_log_user_own" model="ir.rule">
        <field name="name">Audit logs: own records</field>
        <field name="model_id" ref="model_auth_audit_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('enterprise_security_authentication.group_security_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_audit_log_manager_all" model="ir.rule">
        <field name="name">Audit logs: managers see all</field>
        <field name="model_id" ref="model_auth_audit_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('enterprise_security_authentication.group_security_manager'))]"/>
    </record>
</odoo>
